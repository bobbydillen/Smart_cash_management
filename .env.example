# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB connection string (Atlas or self-hosted). Transfers use transactions,
# so it must be a replica set (Atlas always is).
MONGODB_URI=

# Database name. Defaults to smartmart_cash if left out.
MONGODB_DB=smartmart_cash

# Only for scripts/copy-db.mjs: the database to copy into
# TARGET_DB=smartmart_cash_v2
